#!/bin/sh
#
# Recover the wireless link after the USB radio drops off the bus mid-run.
#
# The ATBM6132U fails in at least two ways, both observed on this board.
# Note the errno values are MIPS, not asm-generic: -131 is ECONNRESET and
# -143 is ESHUTDOWN (asm-generic would read those as 104 and 108).
#
#  1. it leaves the USB bus outright -
#       [atbm_log]:atbm_usb_rx_complete1 error status=-131   (in-flight URBs
#       usb 1-1: USB disconnect, device number 2              killed by the
#       [atbm_log]:atbm_usb_prepare_disconnect                disconnect IRQ)
#
#  2. it stays enumerated but goes deaf - "usb=present" yet unassociated for
#     many minutes, preceded by a burst of status=-143 and a
#     prepare_disconnect with NO matching "USB disconnect" line.
#
# Case 2 is why bus presence alone is not a sufficient health check.
#
# Sometimes the driver re-probes and re-associates on its own; often it does
# not, and the camera then stays off the network until someone pulls its power.
# S36wireless already knows how to power-cycle the USB port, but it only runs
# once at boot, so nothing repairs a disconnect that happens later.
#
# Escalation is deliberate: a soft nudge first, and only then the port power
# cycle, because reloading the module drops any association that was merely
# slow to come back rather than genuinely dead.

DAEMON="$0"
PIDFILE="/run/wifi-watchdog.pid"
LOG_TAG="wifi-watchdog"

IFACE=wlan0
CHECK_INTERVAL=15
# Consecutive failed checks before acting. The radio legitimately goes quiet
# during a scan or a roam, so one bad sample must not trigger a recovery.
FAIL_THRESHOLD=3
# Do not attempt another recovery until the previous one had time to settle.
COOLDOWN=90
# Give the boot sequence time to bring the link up the normal way first.
STARTUP_GRACE=90
# After this many failed in-band recoveries, reboot. On this hardware the radio
# can reach a state that nothing short of a power-on clears: rmmod fails even
# with refcount 0 (the driver's own exit path errors), so the module cannot be
# reloaded, and with no drvvbus GPIO the port cannot be re-powered either.
# A reboot restores it every time. Set 0 to disable the escalation.
MAX_ATTEMPTS_BEFORE_REBOOT=3
# Hard ceiling on how long the camera may stay off the network before we give
# up and reboot, regardless of how many recovery attempts actually ran.
MAX_DOWN_BEFORE_REBOOT=600
# Never reboot a board that only just came up - that turns a wifi fault into a
# boot loop.
MIN_UPTIME_FOR_REBOOT=600

WATCHDOG_CONFIG="/etc/default/wifi-watchdog"
[ -f "$WATCHDOG_CONFIG" ] && . "$WATCHDOG_CONFIG"

# Persist to the overlay: start-stop-daemon -b discards stdout, and the whole
# point of this daemon is to act during an outage we cannot watch live.
WDLOG=/overlay/root/wifi-watchdog.log
log() {
	printf '%s %s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "up=$(cut -d' ' -f1 /proc/uptime)" "[$LOG_TAG] $*" >>"$WDLOG"
	sync
}

# In AP/portal mode there is no upstream to check, and tearing the radio down
# would strip the user of the only interface they have to the camera.
is_portal_mode() {
	[ -f /run/portal_mode ]
}

wlan_module() {
	local m

	# S36wireless is generated with the configured radio baked in, so it is
	# the authoritative answer and stays correct for every board. Scanning
	# /sys/module/*/drivers/usb:* instead would be wrong: a board with a USB
	# ethernet dongle matches asix or cdc_ncm first, and we would then power
	# cycle an unrelated peripheral.
	m=$(sed -n 's/^WLAN_MODULE_NAME="\?\([^"]*\)"\?.*/\1/p' \
		/etc/init.d/S36wireless 2>/dev/null | head -1)
	if [ -n "$m" ]; then
		echo "$m"
		return 0
	fi

	# Fallback for a running link: ask the netdev which driver owns it.
	m=$(readlink /sys/class/net/"$IFACE"/device/driver 2>/dev/null)
	if [ -n "$m" ]; then
		basename "$m"
		return 0
	fi

	return 1
}

# Remembered while the link is healthy. This is the whole trick: the driver
# binding under /sys/module/<mod>/drivers/ disappears the moment the device
# leaves the bus, which is exactly when recovery needs it. Resolving the path
# only on failure finds nothing and the recovery silently degrades to a no-op.
USB_DEV_CACHE=""
USB_VID_CACHE=""

usb_wifi_device_live() {
	local module link dev
	module=$(wlan_module) || return 1
	for link in /sys/module/"$module"/drivers/usb:*/[0-9]*-[0-9]*; do
		dev=$(readlink -f "$link" 2>/dev/null) || continue
		while [ -n "$dev" ] && [ "$dev" != "/" ]; do
			if [ -r "$dev/idVendor" ] && [ -w "$dev/authorized" ]; then
				echo "$dev"
				return 0
			fi
			dev=$(dirname "$dev")
		done
	done
	return 1
}

remember_usb_device() {
	local dev
	dev=$(usb_wifi_device_live) || return 1
	USB_DEV_CACHE="$dev"
	USB_VID_CACHE=$(cat "$dev/idVendor" 2>/dev/null)
	return 0
}

usb_wifi_device() {
	local dev vid

	# Live lookup first - it is the only one guaranteed to be current.
	dev=$(usb_wifi_device_live) && { echo "$dev"; return 0; }

	# Deauthorized or disconnected: the port itself still exists in sysfs
	# even with no device behind it, and writing "authorized" there is what
	# re-powers it. Prefer the exact path we saw when the link was up.
	if [ -n "$USB_DEV_CACHE" ] && [ -w "$USB_DEV_CACHE/authorized" ]; then
		echo "$USB_DEV_CACHE"
		return 0
	fi

	# Last resort: find the radio by the vendor ID we recorded earlier.
	if [ -n "$USB_VID_CACHE" ]; then
		for dev in /sys/bus/usb/devices/[0-9]*-[0-9]*; do
			vid=$(cat "$dev/idVendor" 2>/dev/null)
			if [ "$vid" = "$USB_VID_CACHE" ] && [ -w "$dev/authorized" ]; then
				echo "$dev"
				return 0
			fi
		done
	fi

	return 1
}

# Healthy means: the radio is still ON THE USB BUS, the netdev exists, it is
# associated, and it still has an address. Reachability of the gateway is
# deliberately NOT part of this - the AP or the router rebooting is not this
# camera's problem to fix, and power cycling our radio over someone else's
# outage would only add downtime.
#
# The bus-presence check must come first and cannot be replaced by the iw/ip
# checks below: mac80211 keeps reporting the link as associated for ~6.6s
# after the device has already left the bus, so a purely netdev-level probe
# reports "healthy" through the first few samples of a real disconnect.
link_healthy() {
	[ -n "$USB_DEV_CACHE" ] && [ ! -e "$USB_DEV_CACHE/idVendor" ] && return 1

	ip link show dev "$IFACE" >/dev/null 2>&1 || return 1

	if command -v iw >/dev/null 2>&1; then
		iw dev "$IFACE" link 2>/dev/null | grep -qi "^Connected to" || return 1
	else
		iwconfig "$IFACE" 2>/dev/null | grep -qi "Access Point: *[0-9A-F][0-9A-F]:" || return 1
	fi

	ip -4 addr show dev "$IFACE" 2>/dev/null | grep -q "inet " || return 1
	return 0
}

# Every call below can touch the wedged driver, and a wedged ATBM6132U holds
# rtnl indefinitely - an unguarded "ip link"/wpa_supplicant restart then blocks
# FOREVER and takes the whole watchdog loop with it. That is not theoretical:
# it is exactly how this daemon died mid-recovery, after which no further
# attempt ran and the reboot escalation never got a chance to fire.
# Wrap everything; a recovery step that cannot finish is a failed step.
# busybox has shipped two incompatible timeout syntaxes ("timeout -t N CMD"
# on older builds, "timeout N CMD" on newer). Probe once rather than trying
# both per call - trying both risks running a recovery step twice.
TIMEOUT_FORM=""
detect_timeout_form() {
	command -v timeout >/dev/null 2>&1 || { TIMEOUT_FORM="none"; return; }
	if timeout 1 true >/dev/null 2>&1; then
		TIMEOUT_FORM="plain"
	elif timeout -t 1 true >/dev/null 2>&1; then
		TIMEOUT_FORM="dash_t"
	else
		TIMEOUT_FORM="none"
	fi
}

run_guarded() {
	local secs="$1"
	shift
	case "$TIMEOUT_FORM" in
		plain) timeout "$secs" "$@" >/dev/null 2>&1 ;;
		dash_t) timeout -t "$secs" "$@" >/dev/null 2>&1 ;;
		*) "$@" >/dev/null 2>&1 ;;
	esac
}

soft_recover() {
	log "nudging $IFACE (link down but device still present)"
	run_guarded 10 ip link set dev "$IFACE" up
	if [ -x /etc/init.d/S38wpa_supplicant ]; then
		run_guarded 30 /etc/init.d/S38wpa_supplicant restart
	fi
	run_guarded 20 udhcpc -i "$IFACE" -n -q -t 3
}

# Power-cycle the radio via its enable line. This is the only thing observed to
# revive an ATBM6132U that the kernel has given up on ("usb usb1-port1: unable
# to enumerate USB device"). Re-authorizing the USB port does NOT do it: the
# port comes back ("bus presence: present") while the chip stays dead and no
# netdev ever appears. Toggling the enable GPIO actually resets the chip.
#
# Verified live over the serial console on a Cinnado D1, from a boot where
# enumeration had failed four times and been abandoned at t+64s:
#   before: /sys/bus/usb/devices/ = "1-0:1.0 usb1"        (root hub only)
#   after:  /sys/bus/usb/devices/ = "1-0:1.0 1-1 1-1:1.0 usb1"
# followed by S36wireless + wpa_supplicant + DHCP -> inet 192.168.30.31.
wlan_enable_gpio_cycle() {
	local pin g cur other

	# "gpio.wlan" is an int on some profiles and a {pin,active_low} object on
	# others - accept both.
	pin=$(jct /etc/thingino.json get gpio.wlan.pin 2>/dev/null)
	case "$pin" in
		'' | *[!0-9]*) pin=$(jct /etc/thingino.json get gpio.wlan 2>/dev/null) ;;
	esac
	case "$pin" in
		'' | *[!0-9]*) return 1 ;;
	esac

	g=/sys/class/gpio/gpio$pin
	[ -d "$g" ] || echo "$pin" >/sys/class/gpio/export 2>/dev/null
	[ -d "$g" ] || { log "  cannot export gpio $pin"; return 1; }
	echo out >"$g/direction" 2>/dev/null

	# Polarity-agnostic on purpose. active_low is not recorded for this pin on
	# every profile, and guessing it wrong would leave the radio powered off.
	# Whatever level the boot sequence left here IS the enabled level, so pulse
	# to the opposite and return to it.
	cur=$(cat "$g/value" 2>/dev/null)
	case "$cur" in
		0) other=1 ;;
		1) other=0 ;;
		*) log "  gpio $pin unreadable"; return 1 ;;
	esac

	log "  power-cycling radio via gpio $pin ($cur -> $other -> $cur)"
	echo "$other" >"$g/value" 2>/dev/null
	sleep 2
	echo "$cur" >"$g/value" 2>/dev/null
	sleep 3
	return 0
}

hard_recover() {
	local usbdev module
	module=$(wlan_module)
	usbdev=$(usb_wifi_device) || usbdev=""

	if [ -z "$usbdev" ]; then
		log "no USB wifi device found; restarting wireless only"
		run_guarded 45 /etc/init.d/S36wireless restart
		return
	fi

	log "power-cycling USB device $(basename "$usbdev")"

	# Reset the chip first - the USB-authorized dance below cannot.
	wlan_enable_gpio_cycle

	# Best-effort only. Observed on the ATBM6132U: rmmod fails even when
	# /proc/modules reports refcount 0, so treat failure as expected and rely
	# on the port power cycle to trigger a fresh probe on the loaded driver.
	# Deliberately NO rmmod. On the ATBM6132U it can block in an
	# uninterruptible kernel wait, and a process in D state cannot be killed by
	# a signal - so even "timeout 15 rmmod" hangs forever waiting on its child.
	# That parked the entire recovery immediately after the GPIO pulse, twice.
	# It is also unnecessary: cutting power on the enable GPIO produces a real
	# USB disconnect, which unbinds the driver on its own and lets it re-probe
	# when the device re-enumerates.

	run_guarded 10 sh -c "echo 0 >'$usbdev/authorized'"
	sleep 2
	run_guarded 10 sh -c "echo 1 >'$usbdev/authorized'"
	sleep 3
	log "  bus presence after re-authorize: $([ -e "$usbdev/idVendor" ] && echo present || echo GONE)"

	run_guarded 45 /etc/init.d/S36wireless restart
	sleep 2
	log "  netdev after S36wireless: $(ip link show dev "$IFACE" >/dev/null 2>&1 && echo up || echo missing)"

	# S36wireless only creates and configures the interface. Without this the
	# radio comes back on the bus but never re-associates, which is exactly how
	# six consecutive recovery attempts silently achieved nothing.
	if [ -x /etc/init.d/S38wpa_supplicant ]; then
		run_guarded 30 /etc/init.d/S38wpa_supplicant restart
		sleep 8
	fi

	# Verify rather than assume. Observed after a GPIO reset: the init script
	# returns cleanly but leaves no wpa_supplicant running, so the interface
	# comes up and then sits at "Access Point: Not-Associated" forever. Start
	# it directly if the restart did not take.
	if ! pgrep -f "wpa_supplicant.*$IFACE" >/dev/null 2>&1 \
		&& ! ps w 2>/dev/null | grep -q "[w]pa_supplicant"; then
		log "  wpa_supplicant not running after restart, starting it directly"
		run_guarded 20 wpa_supplicant -i "$IFACE" \
			-c /etc/wpa_supplicant.conf \
			-P /run/wpa_supplicant."$IFACE".pid -B
		sleep 10
	fi

	# And nothing re-runs DHCP either, so even an associated link has no address.
	run_guarded 20 udhcpc -i "$IFACE" -n -q -t 5

	log "  result: assoc=$(iwconfig "$IFACE" 2>/dev/null | grep -o 'Access Point: [0-9A-Fa-f:]*' | head -1) addr=$(ip -4 addr show dev "$IFACE" 2>/dev/null | grep -o 'inet [0-9.]*' | head -1)"
}

# A plain "reboot" asks init to run an orderly shutdown, and that shutdown
# HANGS when the radio is wedged - the same rtnl block that can freeze recovery.
# Observed: the watchdog logged "rebooting" eleven times over 21 minutes while
# uptime climbed 774s -> 2064s, i.e. the machine never went down. Ask nicely
# once, then force it. reboot -f calls reboot(2) directly and cannot be blocked
# by userspace; sysrq is the last resort if even that is refused.
do_reboot() {
	sync
	reboot
	sleep 20
	log "  orderly reboot did not take, forcing"
	reboot -f
	sleep 15
	log "  reboot -f did not take, using sysrq"
	echo 1 >/proc/sys/kernel/sysrq 2>/dev/null
	echo b >/proc/sysrq-trigger 2>/dev/null
	sleep 30
}

watchdog_loop() {
	local fails=0 last_recovery=0 attempt=0 now last_healthy=0

	sleep "$STARTUP_GRACE"
	detect_timeout_form
	remember_usb_device
	log "started (interval ${CHECK_INTERVAL}s, threshold $FAIL_THRESHOLD, timeout=$TIMEOUT_FORM, radio ${USB_DEV_CACHE:-unknown})"

	while true; do
		sleep "$CHECK_INTERVAL"

		if is_portal_mode; then
			fails=0
			continue
		fi

		if link_healthy; then
			if [ "$fails" -gt 0 ]; then
				log "$IFACE healthy again"
			fi
			fails=0
			attempt=0
			last_healthy=$(cut -d. -f1 /proc/uptime)
			# Tell the firmware guard this boot was good, so a staged
			# experimental blob is not rolled back after a transient outage.
			[ -f /overlay/root/fw_attempt ] && echo 0 >/overlay/root/fw_attempt
			# Refresh while we still can - see remember_usb_device().
			remember_usb_device
			continue
		fi

		fails=$((fails + 1))
		[ "$fails" -lt "$FAIL_THRESHOLD" ] && continue

		now=$(cut -d. -f1 /proc/uptime)
		[ "$last_healthy" -eq 0 ] && last_healthy=$now

		# Decide on elapsed downtime rather than attempt count. Attempts can be
		# lost (a guarded step that times out still burns the cooldown), and the
		# counter resets on any brief flap, so counting alone can leave a camera
		# offline indefinitely.
		if [ "${MAX_DOWN_BEFORE_REBOOT:-0}" -gt 0 ] \
			&& [ $((now - last_healthy)) -ge "$MAX_DOWN_BEFORE_REBOOT" ] \
			&& [ "$now" -gt "$MIN_UPTIME_FOR_REBOOT" ]; then
			log "$IFACE down $((now - last_healthy))s (uptime ${now}s) - rebooting"
			do_reboot
			continue
		fi

		if [ $((now - last_recovery)) -lt "$COOLDOWN" ]; then
			continue
		fi
		last_recovery=$now
		attempt=$((attempt + 1))

		log "$IFACE unhealthy for $((fails * CHECK_INTERVAL))s, recovery attempt $attempt"

		# Last resort: everything in-band has been tried and the radio is still
		# dead. Staying offline indefinitely is strictly worse than a reboot.
		if [ "${MAX_ATTEMPTS_BEFORE_REBOOT:-0}" -gt 0 ] \
			&& [ "$attempt" -gt "$MAX_ATTEMPTS_BEFORE_REBOOT" ] \
			&& [ "$now" -gt "$MIN_UPTIME_FOR_REBOOT" ]; then
			log "$attempt in-band recoveries failed after ${now}s uptime - rebooting"
			do_reboot
			continue
		fi
		# The netdev disappearing outright means the device left the bus, and
		# no amount of nudging brings it back - go straight to the port cycle.
		# Detached ON PURPOSE. Any recovery step can wedge in the kernel
		# (see the rmmod note above), and if the supervisor waits on it, the
		# downtime check below never runs again and the reboot escalation - the
		# one thing guaranteed to work - is never reached. Recovery is
		# best-effort; staying alive to escalate is mandatory.
		if [ "$attempt" -eq 1 ] && ip link show dev "$IFACE" >/dev/null 2>&1; then
			soft_recover &
		else
			hard_recover &
		fi
		fails=0
	done
}

case "$1" in
	start)
		printf "Starting %s: " "$LOG_TAG"
		start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- watchdog_loop
		echo "OK"
		;;
	stop)
		printf "Stopping %s: " "$LOG_TAG"
		# Match on the pidfile ONLY. The running process is
		# "/bin/sh /etc/init.d/S37wifi-watchdog watchdog_loop", so its
		# executable is /bin/sh - passing -x "$DAEMON" never matches, the old
		# instance survives "restart", and you end up with two daemons racing
		# each other's recovery attempts (and, worse, each able to reboot).
		if [ -f "$PIDFILE" ]; then
			start-stop-daemon -K -q -p "$PIDFILE" 2>/dev/null
		fi
		# Belt and braces: reap any instance whose pidfile was lost.
		# "ps w" is required: without it busybox truncates the command line to
		# the terminal width and the match silently fails, leaving the boot-time
		# instance alive alongside the new one.
		for pid in $(ps w 2>/dev/null | grep "[S]37wifi-watchdog watchdog_loop" | awk '{print $1}'); do
			[ -n "$pid" ] && kill "$pid" 2>/dev/null
		done
		rm -f "$PIDFILE"
		echo "OK"
		;;
	restart)
		"$DAEMON" stop
		sleep 1
		"$DAEMON" start
		;;
	watchdog_loop)
		watchdog_loop
		;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac

exit 0
