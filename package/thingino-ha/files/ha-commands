#!/bin/sh
# Subscribes to Home Assistant command topics and dispatches to camera scripts.
# Runs as a background process inside ha-daemon.
# Publishes state immediately after each command (optimistic update) so HA
# reflects changes instantly without waiting for ha-state's next poll cycle.

. /usr/share/ha-common

[ -n "$HA_CAMERA_ID" ] || { echo "ha-commands: cannot determine camera MAC" >&2; exit 1; }
[ -n "$HA_MQTT_HOST" ] || { echo "ha-commands: ha.mqtt.host (or mqtt_sub.host) not configured" >&2; exit 1; }

# Which streamer is this build running? thingino ships either prudynt (which
# exposes prudyntctl) or raptor (which does not). Every prudyntctl call below
# is a SILENT no-op on a raptor build - the command simply does not exist - so
# the HA day/night, colour, motion and snapshot controls all appeared to work
# while doing nothing at all. Route to the native helpers instead.
have_prudynt() { command -v prudyntctl >/dev/null 2>&1; }

# Move the gimbal one step, or return it to the configured home position.
#
# Signs follow the web UI (a/preview-motors.js): up and right are POSITIVE.
# That matters because the daemon's own invert_x/invert_y flip relative moves,
# so a caller that picked the opposite convention would be inverted on exactly
# the boards where inversion is configured. Note ptz-ctrl uses the opposite
# sign for tilt - thingino is inconsistent here, and the web UI is the one the
# invert flags are tuned against.
#
# Step defaults to a 20th of each axis: small enough to frame with, large
# enough to see. Override with ha.ptz_step (steps, applied to both axes).
ptz_nudge() {
	local dir="$1" span_x span_y step_x step_y cfg

	command -v motors >/dev/null 2>&1 || {
		echo "ha-commands: ptz requested but 'motors' is not installed" >&2
		return
	}

	span_x=$(jct "$HA_CONFIG_FILE" get motors.steps_pan 2>/dev/null | tr -d '"')
	span_y=$(jct "$HA_CONFIG_FILE" get motors.steps_tilt 2>/dev/null | tr -d '"')
	case "$span_x" in '' | *[!0-9]*) span_x=3650 ;; esac
	case "$span_y" in '' | *[!0-9]*) span_y=1200 ;; esac

	step_x=$((span_x / 20))
	step_y=$((span_y / 20))

	cfg=$(ha_cfg ptz_step 2>/dev/null)
	case "$cfg" in '' | *[!0-9]*) : ;; *) step_x=$cfg; step_y=$cfg ;; esac

	case "$dir" in
		up) motors -d g -y "$step_y" >/dev/null 2>&1 ;;
		down) motors -d g -y "-$step_y" >/dev/null 2>&1 ;;
		right) motors -d g -x "$step_x" >/dev/null 2>&1 ;;
		left) motors -d g -x "-$step_x" >/dev/null 2>&1 ;;
		home)
			# Absolute move, so home is where the profile says it is rather
			# than wherever a series of nudges happened to end up.
			local home hx hy
			home=$(jct "$HA_CONFIG_FILE" get motors.pos_0 2>/dev/null | tr -d '"')
			hx=$(echo "$home" | cut -d, -f1)
			hy=$(echo "$home" | cut -d, -f2)
			case "$hx$hy" in
				'' | *[!0-9]*) hx=$((span_x / 2)); hy=$((span_y / 2)) ;;
			esac
			motors -d h -x "$hx" -y "$hy" >/dev/null 2>&1
			;;
	esac
}

# Disable prudynt's automatic day/night management before manual hardware control.
# Without this, prudynt may immediately undo hardware changes. Raptor has no
# equivalent knob, so this is correctly a no-op there.
prudynt_disable_auto() {
	have_prudynt || return 0
	printf '{"daynight":{"enabled":false}}' | prudyntctl json - >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Subscriber command
# LWT ensures HA sees 'offline' if this connection drops unexpectedly.
# ---------------------------------------------------------------------------
MSUB=$(ha_msub_cmd cmd)
# -v prints "topic payload" on each line — do NOT add -F: it was introduced in
# mosquitto 1.5 and its absence causes mosquitto_sub to exit immediately on
# older embedded builds, triggering the infinite reconnect loop.
MSUB="$MSUB -v"
# LWT: broker notifies HA immediately if this connection drops.
#
# Retained, to match how 'online' is published. Every online publish uses -r
# (ha-discovery, ha-state, ha-daemon), so a non-retained will left the LAST
# RETAINED VALUE as 'online' after an ungraceful drop - and an ungraceful drop
# is exactly what a Wi-Fi wedge is. Any HA restart or resubscribe then read
# 'online' for a camera that was gone, showed every entity as available, and
# silently discarded commands published to a topic nobody was subscribed to.
# From the user's side the web UI worked while MQTT "did nothing", with no
# indication why. ha-daemon's graceful shutdown already publishes offline
# retained, so this only aligns the ungraceful path with the graceful one.
MSUB="$MSUB --will-topic ${HA_AVAIL_TOPIC} --will-payload offline --will-qos 1 --will-retain"
MSUB="$MSUB -t 'cameras/${HA_CAMERA_ID}/+/set'"

# ---------------------------------------------------------------------------
# Command dispatcher
# After each command we publish the new state directly so HA gets instant
# feedback instead of waiting for the next ha-state poll cycle.
# ---------------------------------------------------------------------------
dispatch() {
	local topic="$1"
	local payload="$2"

	# cameras/<id>/entity/set → entity
	local entity
	entity=$(printf '%s' "$topic" \
		| sed "s|cameras/${HA_CAMERA_ID}/||; s|/set\$||; s|/|_|g")

	case "$entity" in

		motion_guard)
			# Use prudyntctl directly — calling 'motion enable' goes through the
			# motion event script which has a singleton guard and may fail silently
			# if a motion event is already in progress.
			case "$payload" in
				on|ON|1|true)
					if have_prudynt; then
						printf '{"motion":{"enabled":true}}' | prudyntctl json - >/dev/null 2>&1
						jct /etc/prudynt.json set motion.enabled true >/dev/null 2>&1
					else
						raptorctl config set motion enabled true >/dev/null 2>&1
					fi
					ha_pub_state motion_guard ON
					;;
				off|OFF|0|false)
					if have_prudynt; then
						printf '{"motion":{"enabled":false}}' | prudyntctl json - >/dev/null 2>&1
						jct /etc/prudynt.json set motion.enabled false >/dev/null 2>&1
					else
						raptorctl config set motion enabled false >/dev/null 2>&1
					fi
					ha_pub_state motion_guard OFF
					;;
			esac
			;;

		ircut)
			prudynt_disable_auto
			case "$payload" in
				on|ON|day|1)   ircut on;  ha_pub_state ircut ON  ;;
				off|OFF|night|0) ircut off; ha_pub_state ircut OFF ;;
			esac
			;;

		daynight)
			# Use prudyntctl to set force_mode — this controls both ISP processing
			# and hardware (ircut, LEDs, color) through prudynt's day/night engine.
			case "$payload" in
				day|night)
					if have_prudynt; then
						printf '{"daynight":{"enabled":false,"force_mode":"%s"}}' "$payload" \
							| prudyntctl json - >/dev/null 2>&1
					else
						# The daynight helper drives ircut, ir850 and colour
						# together, and - importantly - updates ircut's state
						# cache, which is what HA reads back.
						daynight "$payload" >/dev/null 2>&1
					fi
					ha_pub_state daynight "$payload"
					;;
			esac
			# Daynight changes ircut/color/ir850 — re-sync all states after settle
			{ sleep 2; ha-state; } &
			;;

		privacy)
			case "$payload" in
				on|ON|1)
					privacy on
					ha_pub_state privacy ON
					;;
				off|OFF|0)
					privacy off
					ha_pub_state privacy OFF
					;;
			esac
			;;

		color)
			# running_mode: 0 = color, 1 = monochrome
			case "$payload" in
				on|ON|1)
					if have_prudynt; then
						printf '{"daynight":{"enabled":false},"image":{"running_mode":0}}' \
							| prudyntctl json - >/dev/null 2>&1
					else
						color on >/dev/null 2>&1
					fi
					ha_pub_state color ON
					;;
				off|OFF|0)
					if have_prudynt; then
						printf '{"daynight":{"enabled":false},"image":{"running_mode":1}}' \
							| prudyntctl json - >/dev/null 2>&1
					else
						color off >/dev/null 2>&1
					fi
					ha_pub_state color OFF
					;;
			esac
			;;

		ir850)
			prudynt_disable_auto
			case "$payload" in
				on|ON|1)
					light ir850 on
					ha_pub_state ir850 ON
					;;
				off|OFF|0)
					light ir850 off
					ha_pub_state ir850 OFF
					;;
			esac
			;;

		ir940)
			prudynt_disable_auto
			case "$payload" in
				on|ON|1)
					light ir940 on
					ha_pub_state ir940 ON
					;;
				off|OFF|0)
					light ir940 off
					ha_pub_state ir940 OFF
					;;
			esac
			;;

		white)
			prudynt_disable_auto
			case "$payload" in
				on|ON|1)
					light white on
					ha_pub_state white ON
					;;
				off|OFF|0)
					light white off
					ha_pub_state white OFF
					;;
			esac
			;;

		snapshot)
			# Same prudynt-vs-raptor split as ha-daemon's live_view: raptor has
			# no prudyntctl, its still comes from rhd's HTTPS endpoint using the
			# credentials in the [http] section of raptor.conf.
			(
				out="/tmp/snap_$(date +%Y%m%d_%H%M%S).jpg"
				if command -v prudyntctl >/dev/null 2>&1; then
					prudyntctl snapshot -c 0 >"$out" 2>/dev/null
				elif [ -r /etc/raptor.conf ]; then
					u=$(sed -n '/^\[http\]/,/^\[/p' /etc/raptor.conf | sed -n 's/^[[:space:]]*username[[:space:]]*=[[:space:]]*//p' | head -1)
					p=$(sed -n '/^\[http\]/,/^\[/p' /etc/raptor.conf | sed -n 's/^[[:space:]]*password[[:space:]]*=[[:space:]]*//p' | head -1)
					curl -sk --max-time 10 -u "${u}:${p}" -o "$out" \
						https://127.0.0.1:8443/snap.jpg 2>/dev/null
				fi
			) &
			;;

		ptz_up | ptz_down | ptz_left | ptz_right | ptz_home)
			[ "$payload" = "1" ] || return
			ptz_nudge "${entity#ptz_}"
			;;

		reboot)
			# An orderly reboot does not always take on this hardware - observed
			# twice on a Cinnado D1, where uptime just kept climbing afterwards.
			# The Wi-Fi watchdog already learned this and escalates; do the same
			# here, or the HA button silently does nothing and the user is left
			# power-cycling by hand. Backgrounded so the dispatcher is not blocked
			# for the escalation timeouts.
			if [ "$payload" = "1" ]; then
				(
					sync
					reboot
					sleep 20
					reboot -f
					sleep 15
					echo b >/proc/sysrq-trigger
				) &
			fi
			;;

		firmware)
			[ "$payload" = "install" ] && (touch /tmp/webupgrade; sysupgrade -p) &
			;;

		*)
			echo "ha-commands: unknown entity '$entity' (topic: $topic)" >&2
			return
			;;
	esac
}

# ---------------------------------------------------------------------------
# Subscriber loop
# ---------------------------------------------------------------------------
echo "ha-commands: subscribing on ${HA_MQTT_HOST}:${HA_MQTT_PORT} for ${HA_CAMERA_ID}"
echo "ha-commands: topics: cameras/${HA_CAMERA_ID}/+/set"

# Use a named FIFO so we can track the mosquitto_sub PID and kill it explicitly
# on exit. Without this, mosquitto_sub becomes an orphan when the pipe closes:
# ha-daemon restarts ha-commands, launching a second mosquitto_sub with the
# same client_id — the two instances then fight each other endlessly, producing
# the "already connected, closing old connection" flood in the broker log.
MSUB_FIFO="/tmp/ha_msub_${HA_CAMERA_ID}.fifo"
rm -f "$MSUB_FIFO"
mkfifo "$MSUB_FIFO" || { echo "ha-commands: cannot create fifo" >&2; exit 1; }

# In BusyBox ash, 'sh -c "simple_command"' execs the command directly, so
# MSUB_PID is the mosquitto_sub PID itself.
sh -c "$MSUB" > "$MSUB_FIFO" 2>&1 &
MSUB_PID=$!

cleanup_sub() {
	kill "$MSUB_PID" 2>/dev/null
	wait "$MSUB_PID" 2>/dev/null
	rm -f "$MSUB_FIFO"
}
trap cleanup_sub EXIT INT TERM

while IFS= read -r line; do
	# mosquitto_sub error lines start with "Error" or contain "Connection"
	case "$line" in
		Error*|*"Connection refused"*|*"authentication"*|*"not authorised"*)
			echo "ha-commands: broker error: $line" >&2
			;;
		*)
			mqtt_topic="${line%% *}"
			mqtt_payload="${line#* }"
			[ -z "$mqtt_topic" ] && continue
			echo "ha-commands: ${mqtt_topic} = ${mqtt_payload}"
			dispatch "$mqtt_topic" "$mqtt_payload"
			;;
	esac
done < "$MSUB_FIFO"

echo "ha-commands: mosquitto_sub exited" >&2
