From: Kostiantyn Levytskyi <le.konstantos@gmail.com>
Subject: [PATCH] motor: 4.4.94: bind on devicetree and take the board pins as parameters

The 4.4.94 copy of the motor driver cannot work on any devicetree SoC as
shipped, so BR2_THINGINO_MOTORS is inert on every xburst2 board:

  - it registers a platform_driver called "tcu_chn2", but the TCU mfd
    names each cell after its devicetree compatible string (see
    init_mfd_cells() in drivers/mfd/ingenic-tcu.c), so the device is
    "ingenic,tcu_chn2". With no of_match_table and no id_table,
    platform_match() never fires and probe() never runs - there is no
    /dev/motor and the driver silently does nothing.

  - it has no module parameters at all, so the phase pins stay at the
    Ingenic reference values hardcoded in motor.h. package/thingino-motors
    S59motor passes hst1..4, vst1..4, hmaxstep, vmaxstep and tcu_channels
    on modprobe - the interface the 3.10.14 copy of this driver already
    implements - and the kernel rejects every one of them as an unknown
    parameter.

Take the same parameters here and bind by compatible, built from
tcu_channels so a board on another TCU channel works too. Parameters left
at -1 keep the compiled-in defaults, so boards relying on motor.h are
unaffected.

Note the 3.10.14 copy assigns motor_match_dynamic[0].compatible from a
char pointer, which does not compile - of_device_id.compatible is an
array. That code sits behind #ifdef CONFIG_SOC_T40 and is never built on
a 3.10 target, which is how it went unnoticed; this version formats into
the array instead.

Three related fixes fall out of making end stops optional:

  - a board that counts steps instead of sensing limits passes no min/max
    gpio, and motor_ops_reset() would call gpio_get_value() on -1 and then
    home into the mechanical stops. Detect that case and take the travel
    from hmaxstep/vmaxstep instead.

  - motor_ops_move() consulted the end stop for the direction of travel
    before every move. On an axis with no end stops that read gpio -1,
    whose error return compared equal to motor_gpio_level, so the driver
    clamped the move to zero steps and the motor never turned - with no
    error anywhere. Only consult an end stop that is actually wired.

  - the gpio guards tested "!= -1" on unsigned fields and, in
    motor_set_default(), plain truthiness - which skips gpio 0 and accepts
    an unset pin. Use gpio_is_valid() throughout.

Tested on a Cinnado D1 (T41NQ): probe now runs, /dev/motor appears, and
both axes step on the pins recovered from the stock firmware.

Signed-off-by: Kostiantyn Levytskyi <le.konstantos@gmail.com>

--- a/4.4.94/misc/motor/motor.c	2026-08-09 00:03:15
+++ b/4.4.94/misc/motor/motor.c	2026-08-09 00:16:39
@@ -57,7 +57,122 @@
 
 extern int jzgpio_ctrl_pull(enum gpio_port port, int enable_pull,unsigned long pins);
 
+/*
+ * Board configuration.
+ *
+ * The pin defaults below come from motor.h and describe Ingenic's own
+ * reference board. Every real PTZ camera wires the steppers differently, so
+ * accept the same module parameters the 3.10 copy of this driver already
+ * takes - that is the interface thingino's S59motor passes on modprobe.
+ * A parameter left at -1 keeps the compiled-in default.
+ */
+#define MOTOR_MAX_TCU	8
 
+static char *motor_tcu_channels;
+module_param_named(tcu_channels, motor_tcu_channels, charp, 0444);
+MODULE_PARM_DESC(tcu_channels, "Comma-separated TCU channels for motor (e.g. 2 or 2,3)");
+
+/* Pan (horizontal) motor phases */
+static int hst1 = -1;
+module_param(hst1, int, S_IRUGO);
+MODULE_PARM_DESC(hst1, "Pan motor Phase A pin");
+
+static int hst2 = -1;
+module_param(hst2, int, S_IRUGO);
+MODULE_PARM_DESC(hst2, "Pan motor Phase B pin");
+
+static int hst3 = -1;
+module_param(hst3, int, S_IRUGO);
+MODULE_PARM_DESC(hst3, "Pan motor Phase C pin");
+
+static int hst4 = -1;
+module_param(hst4, int, S_IRUGO);
+MODULE_PARM_DESC(hst4, "Pan motor Phase D pin");
+
+/* Tilt (vertical) motor phases */
+static int vst1 = -1;
+module_param(vst1, int, S_IRUGO);
+MODULE_PARM_DESC(vst1, "Tilt motor Phase A pin");
+
+static int vst2 = -1;
+module_param(vst2, int, S_IRUGO);
+MODULE_PARM_DESC(vst2, "Tilt motor Phase B pin");
+
+static int vst3 = -1;
+module_param(vst3, int, S_IRUGO);
+MODULE_PARM_DESC(vst3, "Tilt motor Phase C pin");
+
+static int vst4 = -1;
+module_param(vst4, int, S_IRUGO);
+MODULE_PARM_DESC(vst4, "Tilt motor Phase D pin");
+
+/*
+ * End-stop pins. Boards that count steps instead of sensing limits pass -1
+ * (or simply leave these out and set no_limit_gpio), and the driver then
+ * skips the gpio_request()/request_irq() for that axis entirely.
+ */
+static int hmin = -1;
+module_param(hmin, int, S_IRUGO);
+MODULE_PARM_DESC(hmin, "Pan motor start point GPIO, -1 for none");
+
+static int hmax = -1;
+module_param(hmax, int, S_IRUGO);
+MODULE_PARM_DESC(hmax, "Pan motor stop point GPIO, -1 for none");
+
+static int vmin = -1;
+module_param(vmin, int, S_IRUGO);
+MODULE_PARM_DESC(vmin, "Tilt motor start point GPIO, -1 for none");
+
+static int vmax = -1;
+module_param(vmax, int, S_IRUGO);
+MODULE_PARM_DESC(vmax, "Tilt motor stop point GPIO, -1 for none");
+
+/* Travel, in steps, used when the board has no end stops to home against */
+static int hmaxstep = -1;
+module_param(hmaxstep, int, S_IRUGO);
+MODULE_PARM_DESC(hmaxstep, "The max steps of pan motor");
+
+static int vmaxstep = -1;
+module_param(vmaxstep, int, S_IRUGO);
+MODULE_PARM_DESC(vmaxstep, "The max steps of tilt motor");
+
+static int invert_gpio_dir = 0;
+module_param(invert_gpio_dir, int, S_IRUGO);
+MODULE_PARM_DESC(invert_gpio_dir, "Invert motor GPIO values. Default: 0 (no)");
+
+/*
+ * The TCU mfd names each cell after its devicetree compatible string
+ * ("ingenic,tcu_chn2"), so a driver called plain "tcu_chn2" never matches on
+ * a devicetree SoC. Bind by compatible instead, and let tcu_channels pick
+ * which channel to attach to.
+ */
+static int motor_bind_channel = 2;
+static char motor_driver_name[16] = "tcu_chn2";
+static struct of_device_id motor_match_dynamic[2];
+
+static void motor_parse_channels(void)
+{
+	char *str, *p, *tok;
+
+	if (!motor_tcu_channels || !*motor_tcu_channels)
+		return;
+
+	str = kstrdup(motor_tcu_channels, GFP_KERNEL);
+	if (!str)
+		return;
+
+	p = str;
+	while ((tok = strsep(&p, ",")) != NULL) {
+		unsigned long v;
+
+		if (!kstrtoul(tok, 0, &v) && v < MOTOR_MAX_TCU) {
+			motor_bind_channel = (int)v;
+			break;
+		}
+	}
+	kfree(str);
+}
+
 struct motor_platform_data motors_pdata[HAS_MOTOR_CNT] = {
 	{
 		.name = "Horizontal motor",
@@ -80,23 +195,78 @@
 		.motor_st4_gpio		= VERTICAL_ST4_GPIO,
 	},
 };
+
+/* Fold the module parameters into the compiled-in board defaults. */
+static void motor_apply_params(void)
+{
+	struct motor_platform_data *h = &motors_pdata[HORIZONTAL_MOTOR];
+	struct motor_platform_data *v = &motors_pdata[VERTICAL_MOTOR];
+
+	if (hst1 >= 0) h->motor_st1_gpio = hst1;
+	if (hst2 >= 0) h->motor_st2_gpio = hst2;
+	if (hst3 >= 0) h->motor_st3_gpio = hst3;
+	if (hst4 >= 0) h->motor_st4_gpio = hst4;
+
+	if (vst1 >= 0) v->motor_st1_gpio = vst1;
+	if (vst2 >= 0) v->motor_st2_gpio = vst2;
+	if (vst3 >= 0) v->motor_st3_gpio = vst3;
+	if (vst4 >= 0) v->motor_st4_gpio = vst4;
+
+	/*
+	 * Any axis given explicit phase pins is a board that described itself
+	 * fully, so its end stops default to "none" rather than silently
+	 * keeping the reference board's pins and requesting IRQs on lines that
+	 * belong to something else entirely.
+	 */
+	if (hst1 >= 0 || hst2 >= 0 || hst3 >= 0 || hst4 >= 0) {
+		h->motor_min_gpio = -1;
+		h->motor_max_gpio = -1;
+	}
+	if (vst1 >= 0 || vst2 >= 0 || vst3 >= 0 || vst4 >= 0) {
+		v->motor_min_gpio = -1;
+		v->motor_max_gpio = -1;
+	}
 
+	if (hmin >= 0) h->motor_min_gpio = hmin;
+	if (hmax >= 0) h->motor_max_gpio = hmax;
+	if (vmin >= 0) v->motor_min_gpio = vmin;
+	if (vmax >= 0) v->motor_max_gpio = vmax;
+}
+
+/* True when the axis can home itself against a real end stop. */
+static inline int motor_has_limits(struct motor_platform_data *pdata)
+{
+	return gpio_is_valid(pdata->motor_min_gpio) &&
+	       gpio_is_valid(pdata->motor_max_gpio);
+}
+
+/* True only when a wired end stop is actually reading as reached. */
+static inline int motor_limit_asserted(struct motor_platform_data *pdata,
+				       unsigned int gpio)
+{
+	if (!gpio_is_valid(gpio))
+		return 0;
+
+	return gpio_get_value(gpio) == pdata->motor_gpio_level;
+}
+
 static void motor_set_default(struct motor_device *mdev)
 {
 	int index = 0;
+	int off = invert_gpio_dir ? 1 : 0;
 	struct motor_driver *motor = NULL;
 	mdev->dev_state = MOTOR_OPS_STOP;
 	for(index = 0; index < HAS_MOTOR_CNT; index++){
 		motor =  &mdev->motors[index];
 		motor->state = MOTOR_OPS_STOP;
-		if (motor->pdata->motor_st1_gpio)
-			gpio_direction_output(motor->pdata->motor_st1_gpio, 0);
-		if (motor->pdata->motor_st2_gpio)
-			gpio_direction_output(motor->pdata->motor_st2_gpio, 0);
-		if (motor->pdata->motor_st3_gpio)
-			gpio_direction_output(motor->pdata->motor_st3_gpio, 0);
-		if (motor->pdata->motor_st4_gpio)
-			gpio_direction_output(motor->pdata->motor_st4_gpio, 0);
+		if (gpio_is_valid(motor->pdata->motor_st1_gpio))
+			gpio_direction_output(motor->pdata->motor_st1_gpio, off);
+		if (gpio_is_valid(motor->pdata->motor_st2_gpio))
+			gpio_direction_output(motor->pdata->motor_st2_gpio, off);
+		if (gpio_is_valid(motor->pdata->motor_st3_gpio))
+			gpio_direction_output(motor->pdata->motor_st3_gpio, off);
+		if (gpio_is_valid(motor->pdata->motor_st4_gpio))
+			gpio_direction_output(motor->pdata->motor_st4_gpio, off);
 	}
 	return;
 }
@@ -305,26 +475,32 @@
 	int x1 = 0;
 	int y1 = 0;
 	int times = 1;
-	int value = 0;
 
+	/*
+	 * Refuse a move only when the end stop for the direction we are about
+	 * to travel in is actually asserted. An axis with no end stops wired
+	 * has gpio -1 here; reading that returns an error code which happened
+	 * to compare equal to motor_gpio_level, so every move was clamped to
+	 * zero steps and the motor silently never turned.
+	 */
 	/* check x value */
 	if(x > 0){
-		value = gpio_get_value(mdev->motors[HORIZONTAL_MOTOR].pdata->motor_max_gpio);
-		if(value == mdev->motors[HORIZONTAL_MOTOR].pdata->motor_gpio_level)
+		if(motor_limit_asserted(mdev->motors[HORIZONTAL_MOTOR].pdata,
+				mdev->motors[HORIZONTAL_MOTOR].pdata->motor_max_gpio))
 			x = 0;
 	}else{
-		value = gpio_get_value(mdev->motors[HORIZONTAL_MOTOR].pdata->motor_min_gpio);
-		if(value == mdev->motors[HORIZONTAL_MOTOR].pdata->motor_gpio_level)
+		if(motor_limit_asserted(mdev->motors[HORIZONTAL_MOTOR].pdata,
+				mdev->motors[HORIZONTAL_MOTOR].pdata->motor_min_gpio))
 			x = 0;
 	}
 	/* check y value */
 	if(y > 0){
-		value = gpio_get_value(mdev->motors[VERTICAL_MOTOR].pdata->motor_max_gpio);
-		if(value == mdev->motors[VERTICAL_MOTOR].pdata->motor_gpio_level)
+		if(motor_limit_asserted(mdev->motors[VERTICAL_MOTOR].pdata,
+				mdev->motors[VERTICAL_MOTOR].pdata->motor_max_gpio))
 			y = 0;
 	}else{
-		value = gpio_get_value(mdev->motors[VERTICAL_MOTOR].pdata->motor_min_gpio);
-		if(value == mdev->motors[VERTICAL_MOTOR].pdata->motor_gpio_level)
+		if(motor_limit_asserted(mdev->motors[VERTICAL_MOTOR].pdata,
+				mdev->motors[VERTICAL_MOTOR].pdata->motor_min_gpio))
 			y = 0;
 	}
 
@@ -454,6 +630,26 @@
 		mdev->motors[HORIZONTAL_MOTOR].cur_steps = rdata->x_cur_step;
 		mdev->motors[VERTICAL_MOTOR].max_steps = rdata->y_max_steps;
 		mdev->motors[VERTICAL_MOTOR].cur_steps = rdata->y_cur_step;
+		spin_unlock_irqrestore(&mdev->slock, flags);
+		mutex_unlock(&mdev->dev_mutex);
+	}else if(!motor_has_limits(mdev->motors[HORIZONTAL_MOTOR].pdata) ||
+		 !motor_has_limits(mdev->motors[VERTICAL_MOTOR].pdata)){
+		/*
+		 * No end stops to home against. Homing here would drive both
+		 * axes into their mechanical limits and stall, so take the
+		 * travel from the hmaxstep/vmaxstep parameters instead and
+		 * treat the current position as centred.
+		 */
+		if(hmaxstep <= 0 || vmaxstep <= 0){
+			dev_err(mdev->dev, "no end stops and no hmaxstep/vmaxstep, cannot reset\n");
+			return -EINVAL;
+		}
+		mutex_lock(&mdev->dev_mutex);
+		spin_lock_irqsave(&mdev->slock, flags);
+		mdev->motors[HORIZONTAL_MOTOR].max_steps = hmaxstep;
+		mdev->motors[HORIZONTAL_MOTOR].cur_steps = hmaxstep >> 1;
+		mdev->motors[VERTICAL_MOTOR].max_steps = vmaxstep;
+		mdev->motors[VERTICAL_MOTOR].cur_steps = vmaxstep >> 1;
 		spin_unlock_irqrestore(&mdev->slock, flags);
 		mutex_unlock(&mdev->dev_mutex);
 	}else{
@@ -748,7 +944,19 @@
 		motor->move_dir	= MOTOR_MOVE_STOP;
 		init_completion(&motor->reset_completion);
 
-		if (motor->pdata->motor_min_gpio != -1) {
+		/*
+		 * Seed the travel so a board without end stops is usable
+		 * before userspace issues its first MOTOR_RESET.
+		 */
+		if (i == HORIZONTAL_MOTOR && hmaxstep > 0) {
+			motor->max_steps = hmaxstep;
+			motor->cur_steps = hmaxstep >> 1;
+		} else if (i == VERTICAL_MOTOR && vmaxstep > 0) {
+			motor->max_steps = vmaxstep;
+			motor->cur_steps = vmaxstep >> 1;
+		}
+
+		if (gpio_is_valid(motor->pdata->motor_min_gpio)) {
 			gpio_request(motor->pdata->motor_min_gpio, "motor_min_gpio");
 			motor->min_pos_irq = gpio_to_irq(motor->pdata->motor_min_gpio);
 
@@ -766,7 +974,7 @@
 			}
 
 		}
-		if (motor->pdata->motor_max_gpio != -1) {
